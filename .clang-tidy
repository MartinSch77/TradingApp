# clang-tidy configuration (run via tools/static_analysis.sh over the compile
# database; clang-tidy works best with compile_commands.json, which the build
# exports). Findings land on the Axivion dashboard via the external import.
#
# Check families: the analyzer + bug/performance/portability classes plus the
# modernize/readability/cppcoreguidelines/misc style families (target: modern
# C++, up to C++23 as set in CMakeLists.txt) and the handful of google-*/hicpp-*
# checks that are NOT aliases of something already enabled. Auto-fixable
# findings can be applied with tools/static_analysis.sh --fix.
#
# The test sources are analysed too (tests/.clang-tidy inherits this file and
# exempts what Qt Test's moc-driven layout requires).
#
# clang-analyzer-* stays enabled here, and tools/clang_analyzer.py additionally
# runs the Clang Static Analyzer standalone with the off-by-default checkers and
# deeper exploration limits (provider `clang-analyzer`) — clang-tidy cannot pass
# -analyzer-config knobs. Overlapping findings therefore arrive from two
# providers; that is deliberate, the standalone pass is the strict one.
#
# Disabled, with reason:
#   bugprone-easily-swappable-parameters   API-shape noise, no fix suggested
#                                          (16 hits, measured 2026-07-29)
#   performance-enum-size                  micro-optimisation, hurts clarity
#   clang-analyzer-optin.performance.Padding  layout noise
#   modernize-use-trailing-return-type     pure style churn, no gain (403 hits)
#   *magic-numbers                         trading constants / UI layout values
#   readability-identifier-length          Qt idiom (ok, e, i, ui…)
#   cppcoreguidelines-owning-memory        Qt parent/child ownership model
#   readability-redundant-access-specifiers  "private:" after "private slots:"
#                                          is NOT redundant — it ends the moc
#                                          slots section (its removal broke moc)
#   cppcoreguidelines-pro-type-static-cast-downcast  QEvent handling checks
#                                          event->type() first; static_cast is
#                                          the supported Qt idiom there
#   readability-avoid-nested-conditional-operator  the codebase's established
#                                          three-way mapping idiom
#                                          (dir>0 ? A : dir<0 ? B : C) — 77
#                                          hits, pure churn to rewrite
#   readability-function-cognitive-complexity  complexity is already tracked by
#                                          the Axivion McCabe metric AND by
#                                          tools/lizard_metrics.py (CCN/NLOC/
#                                          params, ratcheted) — no third gate
#   misc-include-cleaner                   IWYU-style include hygiene against
#                                          Qt's umbrella headers: 295 hits
#                                          (measured 2026-07-29), a project of
#                                          its own, and its "add this header"
#                                          fixes fight Qt's <QtWidgets> style
#   misc-non-private-member-variables-in-classes  the domain layer is built from
#                                          plain aggregates (MarketSnapshot,
#                                          DecisionRow …). The cppcoreguidelines
#                                          alias, which exempts classes whose
#                                          members are ALL public, stays active
#                                          and covers the real case: a class
#                                          that mixes public data with methods
#   google-default-arguments               NOT enabled (google-* is opt-in here):
#                                          QAbstractItemModel overrides must
#                                          repeat the base class's defaults
#                                          (data(idx, role = DisplayRole) …)
#
#
# The families above are WILDCARDS, so a newer clang-tidy switches on checks the
# pipeline's clang-tidy 18 (Ubuntu 24.04, CI) has never run. The block below was
# measured on 2026-09-30 with clang-tidy 23.1.2 (the newest release build
# reachable from the authoring environment; a developer machine on the 24
# snapshot reported the same set at 1251 findings, CI at 0). Everything else that
# run reported — const-correctness, internal linkage, ranges algorithms, value
# params, C-style casts, std::move, redundant lambda parameter lists, an unused
# private field, a protected override of a public QObject method, the special
# member functions of MainWindow — was FIXED in the code, not listed here.
#   modernize-use-designated-initializers  every positional aggregate init in the
#                                          code base (449 hits); pure churn
#   readability-trailing-comma             a trailing comma after the last element
#                                          of every braced list (329 hits): style
#                                          only, and it changes how .clang-format
#                                          packs the list
#   cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
#                                          flags EVERY operator[] with no data flow
#                                          (275 hits): the indices here are bounded
#                                          by the same container's size(), Qt's
#                                          at() is a Q_ASSERT in debug builds only,
#                                          and a throwing std at() is not an error
#                                          strategy this code has
#   readability-math-missing-parentheses   parentheses around every precedence
#                                          step of `a + b * c` (90 hits); churn
#   cppcoreguidelines-use-enum-class       3 hits, all table-column index enums
#                                          (PositionsModel::Column, HeavyweightsPanel
#                                          Column, CrowdStore Col) whose implicit
#                                          int conversion IS their use
#
# Re-enabled 2026-07-29 after re-measuring at 0 hits (both were "churn" when the
# code still mixed int/qsizetype freely): *narrowing-conversions, cert-err58-cpp.
Checks: >
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  concurrency-*,
  performance-*,
  portability-*,
  modernize-*,
  cppcoreguidelines-*,
  readability-*,
  misc-*,
  google-build-namespaces,
  google-explicit-constructor,
  google-global-names-in-headers,
  google-runtime-int,
  google-runtime-operator,
  hicpp-exception-baseclass,
  hicpp-multiway-paths-covered,
  hicpp-no-assembler,
  hicpp-signed-bitwise,
  -bugprone-easily-swappable-parameters,
  -performance-enum-size,
  -clang-analyzer-optin.performance.Padding,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-identifier-length,
  -cppcoreguidelines-owning-memory,
  -readability-redundant-access-specifiers,
  -cppcoreguidelines-pro-type-static-cast-downcast,
  -readability-avoid-nested-conditional-operator,
  -readability-function-cognitive-complexity,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-designated-initializers,
  -readability-trailing-comma,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -readability-math-missing-parentheses,
  -cppcoreguidelines-use-enum-class
# Any finding is an error: the pipeline gates on a zero finding count, so a
# direct clang-tidy run (IDE, run-clang-tidy) must exit nonzero as well.
WarningsAsErrors: '*'
HeaderFilterRegex: '(src/(domain|services|ui)|tests)/.*'
FormatStyle: none
