# codespell configuration — typo check over sources, docs and scripts
# (tools/static_analysis.sh and tools/static_analysis.ps1 run it; findings feed
# the Axivion dashboard).
[codespell]
skip = build*,docs/html,docs/strictdoc,docs/sphinx-html,.git,coverage,analysis-results,test-results,tools/third-party,*.svg
# Legitimate identifiers/tickers flagged by the dictionary:
#   nam  = QNetworkAccessManager member naming (m_nam, nam)
#   HSI  = Hang Seng Index ticker
#   nD   = "n days" variable in Forecasting
#   Fo   = the MSVC /Fo (object file) compiler switch, in tools/msvc_analyze.py
#   Synopsys = the company (Coverity's vendor before Black Duck), not "synopsis"
#   optin = the Clang Static Analyzer's checker category (optin.cplusplus.*),
#           named in tools/clang_analyzer.py and .clang-tidy
#   zink = Mesa's OpenGL-on-Vulkan driver (QSG_RHI_BACKEND notes in main.cpp /
#          cockpit_main.cpp), not a typo of "zinc"
#   exitin = local variable `exitIn` (SwingExitInputs), 2 hits in
#            StrategyBacktest.cpp — short for "exit inputs", not "exiting"
#   confirmin = local variable `confirmIn` (ConfirmInputs), 8 hits in
#               SwingPullbackStrategy.cpp — short for "confirm inputs", not "confirming"
ignore-words-list = nam,hsi,nd,fo,synopsys,optin,zink,exitin,confirmin
