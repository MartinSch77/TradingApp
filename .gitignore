# Local secrets — the real eToro API keys live here, never commit.
# (config.json itself carries no secrets any more and IS committed.)
apiKeyEtoro.json
*apiKeyEtoro.json
 
# Build output
build/
build_axivion/
dist/
*.user
# Per-run Mull scope config (tools/mutation_test.sh writes/removes it around each
# target; left behind only if a run is interrupted mid-flight).
/mull.yml

# Axivion incremental-analysis state (includes a private shadow Fossil repo).
# The checkout database is named .fslckout on Linux and _FOSSIL_ on Windows.
.axivion-cache/
.fslckout
_FOSSIL_

# Local tool state
.claude/settings.local.json
__pycache__/
# aqtinstall writes this next to the working directory when setup installs Qt.
aqtinstall.log

# Editor / OS — the four SHARED VS Code files are committed, everything else in
# .vscode/ is personal (window layout, per-machine paths, extension state).
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store

# Test / coverage / docs artifacts
build-cov/
build-cov-gcc/
build-cov-mcdc/
build-cov-coco/
# The SEPARATE Coco tree for GUI coverage (tools/coverage.sh coco-gui). Added later than
# the patterns above and missed by both this file and clean_all.sh: measured 2026-08-07 at
# 518 MB, untracked, and one `git add -A` away from being committed.
build-cov-coco-gui/
coverage/
test-results/
docs/html/
docs/traceability.html
docs/strictdoc/
docs/sphinx-html/
tools/third-party/
# Release artifacts (AppImage / portable ZIP) — they belong to a GitHub
# release, not to the history. tools/package_*.{sh,ps1} write them here.
downloads/
# Packaging build trees
build-appimage/
# Android cross-build trees, one per ABI (tools/build_android.sh)
build-android-*/
build-portable/
analysis-results/
build-san/
build-san-tsan/
build-san-ubsan/
build-cov-msvc/
build-mull/
build-release/
# Generated Visual Studio solution (tools/make_vs_solution.ps1). CMakeLists.txt
# is the single description of the build; the .sln is never committed.
build-vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
CMakeUserPresets.json
.vs/
build-android/
build-ios/

# Squish Coco artefacts. The instrumentation databases live in the build trees
# above, but an instrumented binary writes its execution report (<exe>.csexe)
# into the CURRENT directory — so a test run started from the repository root
# leaves them here.
*.csexe
*.csmes

# cppcheck intermediate artefacts. `--dump` and the whole-program (CTU) pass write
# these NEXT TO THE ANALYZED SOURCE rather than into an output directory, so they
# land in src/domain and src/services — inside the tree, named after the file and
# the analyzer's pid (PaperTrader.cpp.967007.dump).
#
# This is not hypothetical: 46 of them, 16 MB, were COMMITTED in d7822e5 and rode
# along in every source archive until 1.0.3 removed them. They are pure derived
# data, regenerated by the next run of tools/misra_cppcheck.sh, and a tracked copy
# is stale the moment the source changes. Note that ignoring does nothing for a
# file already tracked — that took a `git rm --cached`.
*.dump
*.ctu-info
