{
  "mcpServers": {
    "axdocumentation": {
      "type": "stdio",
      "command": "${AXIVION_MCP_PYTHON}",
      "args": [
        "${AXIVION_SUITE_DIR}/mcps/axivion-mcps/ax_documentation/ax_documentation.py"
      ],
      "env": {
        "BAUHAUS_INSTDIR": "${AXIVION_SUITE_DIR}"
      }
    },
    "axdashboard": {
      "type": "stdio",
      "command": "${AXIVION_SUITE_DIR}/bin/rfgscript",
      "args": [
        "${AXIVION_SUITE_DIR}/mcps/axivion-mcps/ax_dashboard/ax_dashboard.py"
      ],
      "env": {
        "BAUHAUS_INSTDIR": "${AXIVION_SUITE_DIR}",
        "BAUHAUS_PYTHON": "${AXIVION_MCP_PYTHON}",
        "BAUHAUS_CONFIG": "./axivion",
        "AXIVION_DATABASES_DIR": "${AXIVION_DATABASES_DIR}"
      }
    }
  }
}
