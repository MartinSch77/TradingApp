{
  "mcpServers": {
    "axdocumentation": {
      "type": "stdio",
      "command": "$(BAUHAUSINSTALLATIONDIR)/mcps/axivion-mcps/.venv/bin/python",
      "args": [
        "$(BAUHAUSINSTALLATIONDIR)/mcps/axivion-mcps/ax_documentation/ax_documentation.py"
      ],
      "env": {
        "BAUHAUS_INSTDIR": "$(BAUHAUSINSTALLATIONDIR)",
        "BAUHAUS_PYTHON": "$(BAUHAUSINSTALLATIONDIR)/mcps/axivion-mcps/.venv/bin/python"
      }
    },
    "axdashboard": {
      "type": "stdio",
      "command": "$(BAUHAUSINSTALLATIONDIR)/bin/rfgscript",
      "args": [
        "$(BAUHAUSINSTALLATIONDIR)/mcps/axivion-mcps/ax_dashboard/ax_dashboard.py"
      ],
      "env": {
        "BAUHAUS_INSTDIR": "$(BAUHAUSINSTALLATIONDIR)",
        "BAUHAUS_PYTHON": "$(BAUHAUSINSTALLATIONDIR)/mcps/axivion-mcps/.venv/bin/python",
        "BAUHAUS_CONFIG": "./axivion",
        "AXIVION_DATABASES_DIR": "$(AXIVIONDATABASESDIR)"
      }
    }
  }
}
